# Chained access

const Point : struct = { let x : float, let y : float };
const Line : struct = { let start : Point, let end : Point };

let a : Line = { start : { x : 0.0, y : 0.0 }, end : { x : 1.0, y : 1.0 } };

# chained member access: a.start.x
let px : float = a.start.x;

# chained index access: matrix[0][1]
let matrix : int[2] = [1, 2];
let cell : int = matrix[0][1];

# call result member access: makePoint().x
let qx : float = makePoint().x;

# chained method call: a.start.normalize()
a.start.normalize();

# chained lvalue assignment
a.start.x = 5.0;
matrix[0] = 9;

