# ==========================================
# BORAN PROGRAMMING LANGUAGE DEMONSTRATION
# this contains all of Boran's main constructs
# ==========================================

# 1. Enums and Structs declared as constants
const Status : enum = { active, inactive, banned };

const Player : struct = {
    const username : string = "Guest", 
    let score : int = 0,
    let status : Status = Status.active,
    
    const levelUp : fn = () => {
        this.score = this.score + 100;
        print("Level up achieved! Default behavior.");
    }
};


# 2. Function declared as a constant
const calculate_bonus : fn = (base_score : int, multiplier : float) : float => {
    return base_score * multiplier;
};

# 3. Main function definition
const main : fn = () : int => {
    
    # Basic I/O: input assigns directly to an identifier
    let name : string = "";
    name = input("Enter your username: ");

    # Struct Instance Initialization
    let p1 : Player = {
        username : name,
        score : 0,
        status : Status.active
    };

    # Unified 'for' keyword (Part A: For-Each / Iteration)
    # Iterating over an array literal
    let rewards : int[3] = [ 10, 20, 30 ];
    for r in rewards {
        p1.score = p1.score + r;
    }

    # Unified 'for' keyword (Part B: While-Loop)
    let counter : int = 0;
    for counter < 3 {
        print("Increasing counter: ", counter);
        # Assignment using standard arithmetic (see observation below)
        counter = counter ++; 
    }

    # Unified 'for' keyword (Part C: Repeat-Until)
    for {
        print("Decreasing counter: ", counter);
        counter = counter --;
    } counter == 0;

    # Conditionals (if / else if / else) and Logical Operators
    if p1.status == Status.active && p1.score > 50 {
        let final_score : float = 0.0;
        final_score = calculate_bonus(p1.score, 1.5);
        print("Great job! Final calculated score: ", final_score);
    } else if p1.status == Status.banned {
        print("Player is currently banned.");
    } else {
        print("Keep trying!");
    }

    # Method call via struct instance
    p1.levelUp();
    print("Score after level up: ", p1.score);

    return 0;
};

main();