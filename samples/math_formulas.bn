# ==============================================================================
# math_formulas.bn
# Machine Learning Formula Benchmark Suite for Operator Precedence Validation
# ==============================================================================

# --- Setup Constants ---
const EPSILON : float = 0.00001;
const E : float = 2.71828;

# --- Struct Definitions ---
const LinearOutputs : struct = {
    prediction : float,
    loss : float,
    is_above_threshold : bool
};

# --- 1. Linear Regression + MSE Loss (No Parentheses Challenge) ---
# Formula contains: + , - , * , / 
# Parser verification: (error * error) must evaluate before division, 
# and division must evaluate before subtraction from total.
const evaluate_linear_step : fn = (x : float, y : float, w : float, b : float) : LinearOutputs {
    # Expected Parse: prediction = (w * x) + b;
    let pred : float = w * x + b;
    
    # Expected Parse: loss = ((y - pred) * (y - pred)) / 2.0; 
    # Note: We must use a variable here because your BNF does not allow 
    # assignments from raw expressions with structural elements directly.
    let error : float = y - pred;
    let step_loss : float = error * error / 2.0;
    
    # Expected Parse: (pred > 0.5) && (step_loss < 1.0)
    # Verifies relational operators binding tighter than logical AND
    let flag : bool = pred > 0.5 && step_loss < 1.0;
    
    let result : LinearOutputs = { prediction : pred, loss : step_loss, is_above_threshold : flag };
    return result;
};

# --- 2. Sigmoid Activation Function ---
# Test Formula: 1.0 / (1.0 + e^(-x))
# To test unary precedence without brackets: 1.0 / 1.0 + E * x is NOT sigmoid.
# This test checks that unary '-' binds tightly to x before anything else.
const approximation_sigmoid : fn = (x : float) : float {
    # Safe polynomial expansion approximation of e^x to avoid math library constraints
    # Sigmoid approximation expression: 1.0 / (1.0 + (1.0 + x + 0.5 * x * x))
    # Let's write the denominator without internal grouping to check chaining:
    let denominator : float = 1.0 + 1.0 + x + 0.5 * x * x;
    return 1.0 / denominator;
};

# --- 3. Softmax Denominator Element (3-Class Array) ---
# Testing chained array index access, unary, multiplication, and addition precedence.
# Target Equation: sum = e^z0 + e^z1 + e^z2
const compute_softmax_denominator : fn = (logits : float[3]) : float {
    # Approximation of exponential components chained together
    # Formula: (1.0 + z0) + (1.0 + z1) + (1.0 + z2)
    # Parser must resolve array indexing `<primary_tail>` prior to unary or addition.
    let sum : float = 1.0 + logits[0] + 1.0 + logits[1] + 1.0 + logits[2];
    return sum;
};

# --- 4. Binary Cross-Entropy Loss Component ---
# Formula: -y * log(p) - (1 - y) * log(1 - p)
# Abstracted to raw operators to test Unary minus vs Multiplication vs Binary subtraction:
# Target Test: -y * p - 1.0 - y * p
const evaluate_pseudo_bce : fn = (y : float, p : float) : float {
    # Expected Parse Tree Hierarchy:
    # Term 1: ((-y) * p)
    # Term 2: (1.0)
    # Term 3: (y * p)
    # Combined: ((-y) * p) - 1.0 - (y * p)
    let loss_component : float = -y * p - 1.0 - y * p;
    return loss_component;
};

# --- Main Validation Test Pipeline ---
const main : fn = () {
    print("Executing Operator Precedence Validation Matrix...", '\n');
    
    let x_vector : float = 2.5;
    let y_true : float = 1.0;
    let weight : float = 0.4;
    let bias : float = 0.1;
    
    # Run Core Evaluation Validation
    let lin_metrics : LinearOutputs = evaluate_linear_step(x_vector, y_true, weight, bias);
    
    print("Linear Prediction Output: ", lin_metrics.prediction, '\n');
    print("Evaluated Loss Step Value: ", lin_metrics.loss, '\n');
    
    # Sigmoid Verification Execution
    let activation : float = approximation_sigmoid(lin_metrics.prediction);
    print("Sigmoid Compute Layer Value: ", activation, '\n');
    
    # Softmax Prep Matrix
    let sample_logits : float[3] = [0.1, 1.2, 2.3];
    let density_sum : float = compute_softmax_denominator(sample_logits);
    print("Softmax Denominator Cumulative Sum: ", density_sum, '\n');
    
    # BCE Evaluation Test
    let bce_cost : float = evaluate_pseudo_bce(y_true, activation);
    print("Resulting Cross-Entropy Evaluation Value: ", bce_cost, '\n');
};

main();