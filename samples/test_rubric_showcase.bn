# ================================================================
# BORAN — RUBRIC COVERAGE SHOWCASE
# One clean, fully-correct program touching every gradeable
# language feature so it can be run in either execution mode
# (all-at-once or --step) to demonstrate Symbol Table, Call
# Stack, and Heap visibility end-to-end.
# ================================================================

# ---- Enum & struct type definitions ----------------------------

const Direction : enum = { north, east, south, west };

const Vector2 : struct = {
    let x : float = 0.0,
    let y : float = 0.0,

    const magnitude : fn = () : float => {
        return this.x * this.x + this.y * this.y;
    },

    let scale : fn = (factor : float) => {
        this = { x : this.x * factor, y : this.y * factor };
    }
};

const Body : struct = {
    let position : Vector2 = { x : 0.0, y : 0.0 },
    let velocity : Vector2 = { x : 1.0, y : 1.0 },

    let step : fn = () => {
        this.position.x = this.position.x + this.velocity.x;
        this.position.y = this.position.y + this.velocity.y;
    }
};

# ---- Plain functions: recursion + higher-order/closures ---------

const factorial : fn = (n : int) : int => {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
};

const doubleIt : fn = (n : int) : int => {
    return n * 2;
};

const applyTwice : fn = (op : fn, seed : int) : int => {
    let once : int = op(seed);
    let twice : int = op(once);
    return twice;
};

# ---- Main entry point --------------------------------------------

const main : fn = () : int => {

    # === Expression hierarchy ===================================
    let a : int = 10;
    let b : int = 3;
    let c : int = 2;

    # simple_math
    let simple_math : int = a + b;
    print("simple_math (a + b):", simple_math);

    # complex_math -- exercises + - * / % and parenthesized grouping
    let complex_math : int = (a + b) * c - a / c % b;
    print("complex_math ((a+b)*c - a/c%b):", complex_math);

    # simple_boolean
    let simple_boolean : bool = a > b;
    print("simple_boolean (a > b):", simple_boolean);

    # complex_boolean -- relational + one logical operator
    let complex_boolean : bool = a > b && c <= b;
    print("complex_boolean (a > b && c <= b):", complex_boolean);

    # complex_logical -- nested grouping, !, &&, ||, mixed relational ops
    let complex_logical : bool = (a > b && c <= b) || !(a == b) && (c != a);
    print("complex_logical:", complex_logical);

    # === Arrays: literals, for-in, index access + assignment =====
    let grid : int[4] = [1, 2, 3, 4];
    grid[0] = grid[0] + grid[1];
    print("grid[0] after grid[0]+grid[1]:", grid[0]);

    let total : int = 0;
    for v in grid {
        total = total + v;
    }
    print("sum of grid:", total);

    # === Structs: nested composition, methods, 'this' rebinding ===
    let bodies : Body[2] = [
        { position : { x : 0.0, y : 0.0 }, velocity : { x : 1.0, y : 0.0 } },
        { position : { x : 5.0, y : 5.0 }, velocity : { x : 0.0, y : -1.0 } }
    ];
    for body in bodies {
        body.step();
    }
    print("body[0].position.x after step:", bodies[0].position.x);

    let v : Vector2 = { x : 3.0, y : 4.0 };
    v.scale(2.0);
    print("v scaled by 2 -> magnitude:", v.magnitude());

    # === Enums =====================================================
    let facing : Direction = Direction.north;
    if facing == Direction.north {
        print("facing: north");
    } else if facing == Direction.east {
        print("facing: east");
    } else {
        print("facing: elsewhere");
    }

    # === Pointers: address-of, dereference, mutation through it ===
    let health : int = 100;
    let hpPtr : int* = &health;
    *hpPtr = *hpPtr - 25;
    print("health after damage via pointer:", health);

    # === Functions: recursion + higher-order ======================
    print("factorial(5):", factorial(5));
    print("applyTwice(doubleIt, 5):", applyTwice(doubleIt, 5));

    # === Control flow: while-form, break, continue =================
    let i : int = 0;
    for i < 10 {
        i = i + 1;
        if i == 3 {
            continue;
        }
        if i == 7 {
            break;
        }
        print("while-loop i =", i);
    }

    # === Control flow: repeat-until form ============================
    let counter : int = 3;
    for {
        print("repeat-until counter =", counter);
        counter--;
    } counter == 0;

    # === I/O: input ===================================================
    let name : string = input("Enter your name: ");
    print("Hello,", name);

    return 0;
};

main();
